NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=avarobe_dev
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
APP_URL=http://localhost:3100
API_PUBLIC_URL=http://localhost:4100
CORS_ORIGINS=http://localhost:3100
# Production: COOKIE_DOMAIN=.avarobe.com, APP_URL=https://avarobe.com,
# API_PUBLIC_URL=https://api.avarobe.com, CORS_ORIGINS=https://avarobe.com,https://www.avarobe.com
OPENAI_API_KEY=
AI_TEXT_MODEL=gpt-5.4-mini
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_QUALITY=medium
# local (dev, files in .storage/) or s3 (prod)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=hello@avarobe.com
# Development only: these addresses get real emails; everyone else gets devLink in the response.
EMAIL_DEV_ALLOWLIST=
DAILY_AVATAR_LIMIT=4
DAILY_LOOK_LIMIT=12
# Safety cap: new AI pictures per account per day across looks, try-ons,
# events, hairstyles, avatar renders and color checks (not color reads).
AI_DAILY_IMAGE_LIMIT=15
# Pro: avatar renders a month; subscriptions paid before the cap keep
# unlimited ones until their next payment ("off": the cap for everyone).
PRO_AVATAR_RUNS_PER_MONTH=20
PRO_AVATAR_GRANDFATHER=on
# Pro annual's first payment: looks right away; the rest of the month's after N days.
PRO_ANNUAL_FIRST_WEEK_CREDITS=10
PRO_ANNUAL_FIRST_WEEK_DAYS=7

# Before they pay, their best color on their face stays locked (blurred) and
# only the worst one shows. "off" gives both away free again.
LOCK_BEST_COLOR=on
